{
  "name": "@agentnomad/cli",
  "version": "1.0.3",
  "private": true,
  "description": "agentnomad command-line interface: commands, prompts, file system, API client, agent adapters",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentnomad": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "agentnomad-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentnomad/contracts": "workspace:*",
    "@agentnomad/core": "workspace:*",
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "@napi-rs/keyring": "2.1.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
